<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<model type="com.apple.IDECoreDataModeler.DataModel" documentVersion="1.0" sourceLanguage="Swift">
    <entity name="Author" representedClassName="Author" syncable="YES" codeGenerationType="class">
        <attribute name="id" attributeType="String"/>
        <attribute name="name" optional="YES" attributeType="String"/>
        <relationship name="books" optional="YES" toMany="YES" deletionRule="Cascade"
                      destinationEntity="Book" inverseName="author" inverseEntity="Book"/>
        <fetchIndex name="byID">
            <fetchIndexElement property="id" type="Binary" order="ascending"/>
        </fetchIndex>
    </entity>
    <entity name="Book" representedClassName="Book" syncable="YES" codeGenerationType="class">
        <attribute name="id" attributeType="String"/>
        <attribute name="pages" attributeType="Integer 64" defaultValueString="0" usesScalarValueType="YES"/>
        <attribute name="read" attributeType="Boolean" defaultValueString="NO" usesScalarValueType="YES"/>
        <attribute name="title" optional="YES" attributeType="String"/>
        <relationship name="author" optional="YES" maxCount="1" deletionRule="Nullify"
                      destinationEntity="Author" inverseName="books" inverseEntity="Author"/>
        <fetchIndex name="byID">
            <fetchIndexElement property="id" type="Binary" order="ascending"/>
        </fetchIndex>
    </entity>
</model>
